{
  "version": 1,
  "description": "Git read and push to one repository: the manager's own (manager.json self).",
  "parameters": {
    "owner": {
      "type": "pathSegment"
    },
    "repo": {
      "type": "pathSegment"
    }
  },
  "routes": [
    {
      "hosts": [
        "github.com"
      ],
      "paths": [
        "/${owner}/${repo}.git/**",
        "/${owner}/${repo}/**"
      ]
    }
  ]
}
